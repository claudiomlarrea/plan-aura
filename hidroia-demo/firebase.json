{
  "hosting": [
    {
      "site": "observatorio-de-ia-uccuyo",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=300"
            }
          ]
        }
      ]
    },
    {
      "site": "plan-aura-hidroia",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=300"
            }
          ]
        }
      ]
    }
  ]
}
